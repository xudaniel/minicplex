<?xml version="1.0" encoding="UTF-8"?>
<!-- minicplex 的 Java 版：零依赖。也可以不用 Maven，直接运行 ./build.sh -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.xudaniel</groupId>
  <artifactId>minicplex</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>minicplex (Java)</name>
  <description>一个迷你 CPLEX：线性规划 + 混合整数规划求解器（C++ 版的逐行移植）</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <!-- 把 examples/ 也当作源码编译进 jar -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-examples</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>examples</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest><mainClass>minicplex.Main</mainClass></manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- 测试是一个普通的 main 程序（不用 JUnit），在 test 阶段运行它 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>run-tests</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>minicplex.SolverTest</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
